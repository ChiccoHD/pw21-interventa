digraph flusso {
  rankdir=LR; bgcolor=white; pad=0.2; nodesep=0.35; ranksep=0.45;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#5b7f8f", fillcolor="#e8f1f4", margin="0.15,0.08"];
  edge [color="#1f6f8b", penwidth=1.4, fontname="Helvetica", fontsize=9];
  gen [label="genera_dati.py\n(seed, volumi)", fillcolor="#a9cbd6"];
  subgraph cluster_csv { label="data/raw  — fonti simulate"; fontname="Helvetica"; fontsize=10; color="#a9cbd6"; style=rounded;
    c1 [label="clienti.csv\n(app clienti)"]; c2 [label="fornitori.csv\n(archivio partner)"];
    c3 [label="operatori.csv\n(gestionale operatori)"]; c4 [label="richieste.csv\n(piattaforma richieste)"]; }
  etl [label="etl.py\nEstrazione · Trasformazione\n· Caricamento", fillcolor="#a9cbd6"];
  dw [label="manolesta_dw.sqlite\nschema a stella", shape=cylinder, fillcolor="#1f6f8b", fontcolor=white];
  sc [label="data/scarti\nrighe scartate + report", fillcolor="#fbeedd", color="#e8a33d"];
  kpi [label="kpi.sql / kpi.py\nindicatori in SQL"]; dash [label="dashboard.py\nStreamlit + Plotly", fillcolor="#a9cbd6"];
  gen -> {c1 c2 c3 c4}; {c1 c2 c3 c4} -> etl; etl -> dw; etl -> sc [style=dashed]; dw -> kpi; dw -> dash [label="vista v_richieste"];
}

// dot -Tpng -Gdpi=200 docs/flusso_dati.dot -o docs/flusso_dati.png
digraph flusso {
  rankdir=LR; bgcolor=white; pad=0.2; nodesep=0.3; ranksep=0.45;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#5b7f8f", fillcolor="#e8f1f4", margin="0.15,0.08"];
  edge [color="#1f6f8b", penwidth=1.4, fontname="Helvetica", fontsize=9];
  gen [label="genera_dati.py\n(seed, volumi)", fillcolor="#a9cbd6"];
  subgraph cluster_csv { label="data/raw  — fonti simulate"; fontname="Helvetica"; fontsize=10; color="#a9cbd6"; style=rounded;
    base [label="dataset iniziale 2025\nclienti · fornitori\noperatori · richieste"];
    inc [label="incrementi/AAAA-MM\nanagrafiche aggiornate\n+ richieste del mese"]; }
  etl [label="etl.py\nestrazione · trasformazione\ncaricamento iniziale e incrementale\nstorico SCD tipo 1 e 2", fillcolor="#a9cbd6"];
  dq [label="qualita.py\n14 controlli con soglie\nOK · AVVISO · ERRORE", fillcolor="#fbeedd", color="#e8a33d"];
  dw [label="interventa_dw.sqlite\nschema a stella\n+ registro caricamenti", shape=cylinder, fillcolor="#1f6f8b", fontcolor=white];
  sc [label="data/scarti\nrighe scartate + report", fillcolor="#fbeedd", color="#e8a33d"];
  kpi [label="kpi.sql / kpi.py\nindicatori in SQL"]; dash [label="dashboard Streamlit\nAndamento · Qualità dei dati", fillcolor="#a9cbd6"];
  gen -> {base inc}; {base inc} -> etl; etl -> dq [label="prima del\ncommit"]; dq -> dw [label="COMMIT o\nROLLBACK"]; etl -> sc [style=dashed];
  dw -> kpi; dw -> dash;
}
